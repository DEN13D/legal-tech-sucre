# Copie este archivo como .env (no lo suba a GitHub) o ponga estas variables en Render.

# Token de acceso de la app de WhatsApp en developers.facebook.com
# (el temporal dura 24 horas; para la prueba larga cree un token de usuario del sistema)
WHATSAPP_TOKEN=

# "Identificador del número de teléfono" del número de prueba de Meta
PHONE_NUMBER_ID=

# Una palabra secreta que usted inventa; la misma se escribe en Meta al configurar el webhook
VERIFY_TOKEN=legaltechsucre-prueba

# "Clave secreta de la app" (Configuración de la app > Básica). Verifica que los mensajes vengan de Meta
APP_SECRET=

# Clave para que el equipo vea los casos en /casos?clave=...
ADMIN_KEY=

# Opcional: número (con 57 adelante) que recibe avisos de casos nuevos, asesor y urgencias
EQUIPO_NUMERO=

# Opcional
GRAPH_VERSION=v25.0
PAGINA_URL=https://den13d.github.io/legal-tech-sucre/
